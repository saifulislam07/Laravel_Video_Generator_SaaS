# =====================================================================
#  PRODUCTION ENV — copy to .env on the server and fill every blank.
#  Never commit the real .env. Generate APP_KEY with `php artisan key:generate`.
# =====================================================================

APP_NAME="Video Generator"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com          # MUST be the public https host — Shotstack fetches asset URLs from here

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=cache
APP_MAINTENANCE_STORE=redis

BCRYPT_ROUNDS=12

# --- Logging -----------------------------------------------------------
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# --- Database (MySQL 8) ----------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=video_generator
DB_USERNAME=video_generator
DB_PASSWORD=

# --- Redis (sessions, cache, queue, broadcasting scaling) -----------
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.your-domain.com

CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Broadcasting: Laravel Reverb ----------------------------------
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=your-domain.com
REVERB_PORT=443
REVERB_SCHEME=https
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

VITE_APP_NAME="${APP_NAME}"
VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# --- File storage -----------------------------------------------------
# `public` keeps uploads on the app server (php artisan storage:link).
# Switch to `s3` for horizontal scaling / durable render archives.
FILESYSTEM_DISK=public
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# --- Mail -----------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Shotstack (video rendering) ----------------------------------
# Use the PRODUCTION key + env for live (paid, no watermark) renders.
SHOTSTACK_API_KEY=
SHOTSTACK_ENV=production
SHOTSTACK_TEMPLATE_ID=
SHOTSTACK_WEBHOOK_SECRET=                 # random 32+ char string; also used to sign the callback URL

# Archive finished renders to S3 so they outlive the Shotstack CDN url.
RENDER_ARCHIVE_ENABLED=true
RENDER_ARCHIVE_DISK=s3

# --- Meta Graph API (publish to Facebook / Instagram) ------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/social/facebook/callback"
FACEBOOK_GRAPH_VERSION=v21.0

# --- Payment gateways (bKash / SSLCommerz) ------------------------
# Fill these when you connect the real gateways (see app/Services/Billing).
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=
BKASH_SANDBOX=false
SSLCZ_STORE_ID=
SSLCZ_STORE_PASSWORD=
SSLCZ_SANDBOX=false
